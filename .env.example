# BroEditz Frontend - Environment Variables
# Copy to .env.local and fill as needed. Frontend works WITHOUT backend using dummy data.

# Optional: Connect to Django backend if available
# Leave empty or unset to run in 100% dummy/demo mode (recommended for GitHub demo)
NEXT_PUBLIC_BACKEND_API_BASE_URL=http://localhost:8005/v1/api

# Optional: If backend is deployed
# NEXT_PUBLIC_BACKEND_API_BASE_URL=https://api.broeditz.com/v1/api
